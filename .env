# Development values for the stand-in stack, tracked deliberately: nothing here
# is a real credential — every value belongs to a stand-in system this repository
# also defines. See .env.example for what each setting means and for the ones a
# real deployment must replace.
#
# A production deployment must NOT keep these. The signing secret below is known
# to anyone with the repository, so `compose.yml` reading this file means the
# guard on that setting cannot protect a real deployment; replace the file.

# --- CSCI edge -------------------------------------------------------------
# Browser origins the CSCI answers, comma-separated. The operator's web
# application is served from an origin of its own, so every call it makes is
# cross-origin; with none named the CSCI answers no browser at all, which is
# deliberate — answering any origin would let a page anywhere drive the CSCI with
# an operator's session.
WEB_ORIGINS=http://localhost:3000

# --- Operations panel (VAE-01) ---------------------------------------------
VAE_JWT_SECRET=demo-signing-secret-at-least-32-characters-long
VAE_SESSION_MINUTES=480
# Shorter than the documented default so the accessibility stream is observable
# while developing.
VAE_SOURCE_STREAM_SECONDS=3

# --- Directory service (EXT-IF-06) -----------------------------------------
LDAP_URL=ldap://openldap:389
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=saag,dc=local
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=saag,dc=local
LDAP_SERVICE_BIND_DN=cn=admin,dc=saag,dc=local
LDAP_SERVICE_PASSWORD=saag-standin-admin
LDAP_GROUP_AUTHORIZATIONS=view=saag-viewers,configure_sources=saag-operators,produce_model_setup_data=saag-operators

# --- Model Setup Data Generation (MSD) -------------------------------------
MSD_SOURCE_SEED_FILE=/app/tests/standins/sources.json
MSD_OUTPUT_DIR=/var/lib/saag/msd
MSD_WORKSPACE_DIR=/var/lib/saag/workspace

# --- Credentials for the configured data sources ---------------------------
# The stand-in git server serves its repositories publicly, so those sources name
# no credential at all; a real Bitbucket or GitLab entry would.
MSD_CMDB_PRIMARY_SECRET=saag
MSD_ARTIFACTORY_TOKEN=standin-registry-token

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://saag:saag@postgres:5432/saag
POSTGRES_USER=saag
POSTGRES_PASSWORD=saag
POSTGRES_DB=saag

# --- Stand-in systems (development only) -----------------------------------
GITEA_ADMIN_USER=saag
GITEA_ADMIN_PASSWORD=saag-standin-password
LDAP_ADMIN_PASSWORD=saag-standin-admin
