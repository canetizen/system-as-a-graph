# Copy to .env and edit. The .env file is never committed.
#
# Every secret SaaG needs is named here. Nothing in the code carries a
# fallback: a service whose secret is missing refuses to start rather than
# running with a value that would also be in the repository.

# --- Operations panel (VAE-01) ---------------------------------------------
# Signing key for session tokens. At least 32 characters (HMAC-SHA256).
VAE_JWT_SECRET=change-me-to-a-32-character-minimum-secret
# How long a session stays valid, in minutes.
VAE_SESSION_MINUTES=480
# How often the accessibility stream re-probes the sources, in seconds.
VAE_SOURCE_STREAM_SECONDS=15
# --- Directory service (EXT-IF-06) -----------------------------------------
LDAP_URL=ldap://openldap:389
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=saag,dc=local
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=saag,dc=local
# Read-only account the group search binds as.
LDAP_SERVICE_BIND_DN=cn=admin,dc=saag,dc=local
LDAP_SERVICE_PASSWORD=saag-standin-admin
# Which directory group grants which authorization.
LDAP_GROUP_AUTHORIZATIONS=view=saag-viewers,configure_sources=saag-operators,produce_model_setup_data=saag-operators

# --- Model Setup Data Generation (MSD) -------------------------------------
# Sources a fresh deployment starts with: connection addresses, access methods,
# and the queries or URL templates each technology needs. Unset means an
# operator configures the sources through the panel instead.
MSD_SOURCE_SEED_FILE=/app/tests/standins/sources.json
# Where produced Model Setup Data files are written.
MSD_OUTPUT_DIR=/var/lib/saag/msd
# Where transferred source files are copied to.
MSD_WORKSPACE_DIR=/var/lib/saag/workspace
# Replacement rules file (file classification, mandatory files/fields,
# extraction patterns). Defaults to the one shipped in the package.
# MSD_RULES_FILE=/etc/saag/rules.json
# Where the Ansible tree the network topology is read from is mounted.
# The source's connection address points at this path.
# (dev compose mounts tests/standins/ansible here)

# --- Credentials for the configured data sources ---------------------------
# One per configured source: the source configuration stores only the *name*
# of the variable, so rotating a credential is an edit here and nothing else.
# The configuration management database password, the git tokens, and the
# package registry token. The stand-in git server needs no token, so those may
# stay empty until a real server is configured.
MSD_CMDB_PRIMARY_SECRET=change-me
# The stand-in git server serves its repositories publicly, so those sources
# name no credential at all; a real Bitbucket or GitLab entry would.
MSD_ARTIFACTORY_TOKEN=standin-registry-token

# --- Storage ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://saag:saag@postgres:5432/saag
POSTGRES_USER=saag
POSTGRES_PASSWORD=saag
POSTGRES_DB=saag

# --- Stand-in systems (development only) -----------------------------------
# None of these exist in production: there the adapters point at the real
# servers and only the addresses above change.
GITEA_ADMIN_USER=saag
GITEA_ADMIN_PASSWORD=saag-standin-password
LDAP_ADMIN_PASSWORD=saag-standin-admin
