{
  "file_classification": [
    { "pattern": "deployment/*.xml", "kind": "system_deployment_descriptor" },
    { "pattern": "generated/*TypeSupport.java", "kind": "generated_type_support" },
    { "pattern": "src/*.xml", "kind": "unit_descriptor" },
    { "pattern": "Makefile", "kind": "build_descriptor" },
    { "pattern": "install/*.sh", "kind": "installation_script" },
    { "pattern": "config/*.properties", "kind": "runtime_configuration" },
    { "pattern": "*.java", "kind": "source_code" }
  ],
  "mandatory_files": [
    { "pattern": "Makefile", "kind": "build_descriptor", "per_unit": true },
    { "pattern": "src/*.xml", "kind": "unit_descriptor", "per_unit": true },
    { "pattern": "install/*.sh", "kind": "installation_script", "per_unit": true },
    { "pattern": "config/*.properties", "kind": "runtime_configuration", "per_unit": true },
    { "pattern": "deployment/*.xml", "kind": "system_deployment_descriptor", "per_unit": false }
  ],
  "mandatory_fields": [
    { "node_type": "topic", "required_attributes": ["durability", "reliability", "transport_priority"] },
    { "node_type": "csu", "required_attributes": ["version"] },
    { "node_type": "processor_unit", "required_attributes": [] }
  ],
  "java_import_extraction": {
    "import_domain_prefix": "a.b.c",
    "dependency_suffixes": ["_lib"]
  },
  "unit_descriptor_extraction": {
    "topic_element": "topic",
    "name_attribute": "name",
    "role_attribute": "role",
    "dummy_topic_names": ["dummytopic"]
  },
  "type_support_extraction": {
    "file_glob": "generated/*TypeSupport.java",
    "topic_name_pattern": "TOPIC_NAME\\s*=\\s*\"([^\"]+)\"",
    "field_patterns": {
      "size": "TOPIC_SIZE\\s*=\\s*(\\d+)",
      "durability": "QOS_DURABILITY\\s*=\\s*\"([A-Z_]+)\"",
      "reliability": "QOS_RELIABILITY\\s*=\\s*\"([A-Z_]+)\"",
      "transport_priority": "QOS_TRANSPORT_PRIORITY\\s*=\\s*\"([A-Z_]+)\""
    }
  },
  "system_descriptor_extraction": {
    "unit_element": "unit",
    "unit_name_attribute": "name",
    "processor_unit_attribute": "runs_on",
    "role_element": "role",
    "role_name_attribute": "name",
    "criticality_attribute": "criticality"
  },
  "code_generation": {
    "mode": "prebuilt",
    "command": ["gmake", "regenerate_code"],
    "timeout_seconds": 300
  }
}
